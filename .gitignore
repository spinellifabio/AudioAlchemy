# CocoIndex Code (ccc): keep only the settings
/.cocoindex_code/*
!/.cocoindex_code/settings.yml

# Python bytecode / extensions
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Packaging / build output
/build/
/dist/
.eggs/
*.egg
*.egg-info/
*.whl
*.tar.gz

# Test / lint caches
.cache/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Virtual environments
.venv/
venv/
env/

# Local environment (copy .env.example to .env)
/.env

# IDEs
.vscode/
.idea/
.vs/
*.sublime-project
*.sublime-workspace

# Local link to CONTRIBUTING.md for Claude Code (recreate: New-Item -ItemType SymbolicLink CLAUDE.md -Target CONTRIBUTING.md)
/CLAUDE.md

# Claude Code: skills are third-party and regenerable (specify init), nothing to share yet
/.claude/

# Spec Kit: track only the constitution; scripts/templates/integrations come from the Specify CLI
/.specify/*
!/.specify/memory/
/.specify/memory/*
!/.specify/memory/constitution.md

# Logs and crash dumps
*.log
*.stackdump

# OS
Thumbs.db
.DS_Store
